# Python Byte-compiled & Environment files
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/

# Secrets & Environment Variables (Keep API keys safe)
.env
.env.local
.env.*.local

# Raw Datasets & Binary Files
AI/data/*.mat
AI/data/*.dat
AI/data/*.hea
AI/data/ptbxl/
AI/data/mitdb/
data/
*.csv
scratch/

# Application Logs & Decorative UI PNGs
*.log
AI/logs/
static/images/

# Exclude ALL PNG images inside saved_models (All evaluation plots are neatly organized in AI/plots/)
AI/saved_models/*.png

# Unused Model Weights & Duplicate Checkpoints in saved_models
AI/saved_models/*.pth
AI/saved_models/arrhythmia_*
AI/saved_models/model.pkl
AI/saved_models/scaler.pkl
AI/saved_models/shap_explainer.pkl

# Node / React Frontend Dependencies & Build Caches
frontend/node_modules/
frontend/.vite/
frontend/dist-ssr/
frontend/*.local

# OS / IDE Junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.tmp
